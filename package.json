{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/run.ps1 -Frontend",
    "dev:client": "pnpm.cmd --dir client dev",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts/run.ps1",
    "build": "pnpm.cmd --dir client build",
    "preview": "pnpm.cmd --dir client preview",
    "format": "oxfmt",
    "dev:api": "powershell -ExecutionPolicy Bypass -File scripts/run.ps1 -Backend",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1",
    "db:show": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1 -Show",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "https:lan": "node scripts/lan-https.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@figma/astraui": "^1.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@mui/material": "7.3.5",
    "@mui/x-date-pickers": "^8.17.0",
    "@tanstack/react-query": "^5.90.0",
    "date-fns": "^4.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.15.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
