{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "node scripts/project.mjs run",
    "dev:client": "node scripts/project.mjs run --frontend",
    "dev:full": "node scripts/project.mjs run",
    "build": "pnpm.cmd --dir client build",
    "preview": "pnpm.cmd --dir client preview",
    "format": "oxfmt",
    "dev:api": "node scripts/project.mjs run --backend",
    "db:status": "node scripts/project.mjs check",
    "db:show": "node scripts/project.mjs check",
    "db:migrate": "node scripts/project.mjs update",
    "db:add": "node scripts/project.mjs add",
    "db:update": "node scripts/project.mjs update",
    "db:check": "node scripts/project.mjs check",
    "test:scripts": "node --test scripts/test/project.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@figma/astraui": "^1.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@mui/material": "7.3.5",
    "@mui/x-date-pickers": "^8.17.0",
    "@tanstack/react-query": "^5.90.0",
    "date-fns": "^4.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.15.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
