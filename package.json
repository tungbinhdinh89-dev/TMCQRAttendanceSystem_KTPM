{
  "name": "tmc-access-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --dir client dev",
    "dev:client": "pnpm --dir client dev",
    "dev:api": "pnpm --dir api start:dev",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "start:api": "pnpm --dir api start",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/db.ps1 -Action status",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/db.ps1 -Action setup",
    "build": "pnpm run build:client && pnpm run build:api",
    "build:client": "pnpm --dir client build",
    "build:api": "pnpm --dir api build",
    "preview": "pnpm --dir client preview",
    "test": "pnpm --dir api test",
    "typecheck": "pnpm --dir contracts typecheck && pnpm --dir client typecheck && pnpm --dir api typecheck",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.2.0"
  }
}
