{
  "name": "@tmc/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start:dev": "node --import ./scripts/load-env.mjs ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "pnpm run build && node scripts/start.mjs",
    "seed:demo": "pnpm build && node --import ./scripts/load-env.mjs dist/platform/infrastructure/database/seeds/demo-seed.js",
    "test": "pnpm run build && node --test test/auth.service.test.mjs test/bootstrap.test.mjs test/runtime-env.test.mjs test/load-env.test.mjs test/audit.service.test.mjs",
    "test:integration": "pnpm build && node dist/platform/infrastructure/database/seeds/demo-seed.js && node --test test/integration/**/*.test.mjs",
    "test:management": "pnpm build && node --test test/employees.test.mjs test/configuration-policy.test.mjs",
    "test:qr": "pnpm build && node --test test/qr.test.mjs",
    "test:onboarding": "pnpm build && node --test test/employee-onboarding.test.mjs test/employee-pagination.test.mjs",
    "test:api-docs": "pnpm build && node --test test/openapi.test.mjs test/api-exception.test.mjs",
    "test:authorization": "pnpm build && node --test test/authorization.test.mjs test/bootstrap.test.mjs test/configuration-policy.test.mjs test/qr.test.mjs test/employee-account.test.mjs",
    "test:scanner": "pnpm build && node --test test/scanner.test.mjs test/openapi.test.mjs",
    "test:history": "pnpm build && node --test test/attendance-history.test.mjs test/attendance-history-http.test.mjs test/openapi.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@tmc/contracts": "workspace:*",
    "express": "5.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
