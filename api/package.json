{
  "name": "@tmc/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start:dev": "node --import ./scripts/load-env.mjs ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node scripts/start.mjs",
    "seed:demo": "pnpm build && node --import ./scripts/load-env.mjs dist/platform/infrastructure/database/seeds/demo-seed.js",
    "test": "pnpm run build && node --test test/auth.service.test.mjs test/bootstrap.test.mjs test/runtime-env.test.mjs",
    "test:integration": "pnpm build && node --import ./scripts/load-env.mjs --test test/integration/demo-seed.integration.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@tmc/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
